# ========================================================
# Configurações de Produção - Uniqprint (Rede Local)
# ========================================================

# Porta onde o sistema responderá (padrão: 3001)
PORTA=3001
HOST=0.0.0.0
AMBIENTE=production

# Em rede local (HTTP), mantenha COOKIE_SEGURO=false para que o navegador aceite o login
COOKIE_SEGURO=false

# Conexão com o MySQL nativo do Windows (ajuste usuario, senha e porta do seu MySQL)
# Se o MySQL estiver na porta padrão 3306:
BANCO_DE_DADOS_URL="mysql://root:SENHA_DO_MYSQL@localhost:3306/uniqprint_db"

# Segredos criptográficos (chaves com no mínimo 16 caracteres aleatórios)
JWT_SEGREDO="uniqprint_jwt_segredo_super_forte_producao_2026"
COOKIE_SEGREDO="uniqprint_cookie_segredo_super_forte_producao_2026"

# Endereço ou IP da máquina servidora
ORIGEM_FRONTEND="http://localhost:3001"

